# Nyanopan environment variables.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys (engineering rule #9).

# --- Supabase ---
# Milestone 2 uses the LOCAL Supabase CLI. Start it with `npx supabase start`,
# then run `npx supabase status` to print the values below.
# Moving to hosted Supabase later only requires replacing these two values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-value-from-supabase-status

# Service-role key: SERVER ONLY. Grants full database access, bypasses RLS.
# Never import this in client components, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-value-from-supabase-status

# --- App ---
# Canonical site URL, used for metadata and (later) auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
