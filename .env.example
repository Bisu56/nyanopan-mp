# Nyanopan environment variables.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys (engineering rule #9).

# --- Supabase ---
# Start local services with `npx supabase start`, then copy the URL and
# publishable key from `npx supabase status`. Production uses the matching
# production project URL and publishable key; keep Preview on a staging project.
# This app does not require a service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-value-from-supabase-status

# --- App ---
# Canonical origin for metadata and Supabase Auth Site URL configuration.
# Set to the exact HTTPS production origin in the hosting provider's Production env.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Checkout ---
# Optional server-only text shown for manual payment. Never use NEXT_PUBLIC_ here.
MANUAL_PAYMENT_INSTRUCTIONS=
